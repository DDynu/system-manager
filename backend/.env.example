# Target machine, format: host:port:user
TARGETS=192.168.100.50:22:root

# Private key on THIS server that the target has authorized
# (its public part goes in ~/.ssh/authorized_keys on the target)
SSH_KEY_PATH=~/.ssh/id_ed25519

# Fallback password auth. Leave empty to use key auth only.
SSH_PASSWORD=

# Connection settings
SSH_TIMEOUT=10
SSH_RETRIES=1

# CORS. Empty = allow all origins, which is fine when the frontend
# is served from the same server.
ALLOWED_ORIGINS=
ALLOWED_WS_ORIGINS=

# Wake-on-LAN. MAC address of the target's wired NIC (the one holding its
# LAN IP, e.g. from `arp -n <target>` on this server). Leave empty to disable.
WOL_MAC_ADDRESS=
